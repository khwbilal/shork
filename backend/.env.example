# Copy this file to backend/.env and fill in your keys.
# NEVER commit backend/.env — it is gitignored.
# The file is re-read on every request, so key changes apply without a restart.

# Which AI answers. start.ps1 / start.sh ask you and write this line.
#   claude_code  Claude subscription — your Claude Code login (Pro / Max plan usage)
#   claude       Claude API — ANTHROPIC_API_KEY, billed per token
#   cursor       Cursor agents — CURSOR_API_KEY
#   openai       OpenAI — OPENAI_API_KEY
#   none         market data and the deterministic plan only
#   auto         first configured key: claude → claude_code (token only) → cursor → openai
AI_PROVIDER=auto

# ── Claude subscription (Claude Code CLI) ─────────────────────────────────────
# Uses the CLI's login (`claude auth login`). For a fixed token instead, run
# `claude setup-token` and paste it here.
CLAUDE_CODE_OAUTH_TOKEN=
# Blank = your plan's default model; or opus / sonnet / a full model id
CLAUDE_CODE_MODEL=
CLAUDE_CODE_EFFORT=medium
# Blank = find `claude` on PATH
CLAUDE_CODE_PATH=
CLAUDE_CODE_TIMEOUT=300

# ── Claude API ── https://console.anthropic.com/settings/keys ─────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning depth: low | medium | high | xhigh | max (blank = model default)
ANTHROPIC_EFFORT=medium

# ── Cursor ── https://cursor.com/dashboard/integrations ───────────────────────
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# ── OpenAI ── https://platform.openai.com/api-keys ────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional — unlocks news/sentiment tools
MARKETAUX_API_TOKEN=

# Optional — real Coinglass liquidation history (estimated liquidity map works without it)
COINGLASS_API_KEY=

DEFAULT_EXCHANGE=BINANCE
DEFAULT_TIMEFRAME=1h
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: SQLite file for journal and signals (blank = backend/data/app.db)
DB_PATH=
# Optional: folder for the daily db backup (blank = backups/ at the repo root)
BACKUP_DIR=
