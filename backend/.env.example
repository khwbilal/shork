# Copy this file to backend/.env and fill in your keys.
# NEVER commit backend/.env — it is gitignored.

# Prefer Cursor API key (same agent runtime as Cursor IDE)
# https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# Fallback if you don't have a Cursor key yet
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional — unlocks news/sentiment tools
MARKETAUX_API_TOKEN=

# Optional — real Coinglass liquidation history (estimated liquidity map works without it)
COINGLASS_API_KEY=

DEFAULT_EXCHANGE=BINANCE
DEFAULT_TIMEFRAME=1h
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
